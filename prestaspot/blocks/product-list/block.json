{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "prestaspot/product-list",
    "title": "PrestaShop Product List",
    "category": "widgets",
    "icon": "store",
    "description": "Display products from a connected PrestaShop store as cards.",
    "keywords": ["prestashop", "products", "shop", "cards"],
    "version": "0.15.1",
    "textdomain": "prestaspot",
    "attributes": {
        "productCount": {
            "type": "number",
            "default": 8
        },
        "categoryId": {
            "type": "number",
            "default": 0
        },
        "onSale": {
            "type": "boolean",
            "default": false
        },
        "columns": {
            "type": "number",
            "default": 4
        },
        "showImage": {
            "type": "boolean",
            "default": true
        },
        "showName": {
            "type": "boolean",
            "default": true
        },
        "showDescription": {
            "type": "boolean",
            "default": true
        },
        "showPrice": {
            "type": "boolean",
            "default": true
        },
        "showStockStatus": {
            "type": "boolean",
            "default": true
        },
        "pricePosition": {
            "type": "string",
            "default": "after_name"
        },
        "sort": {
            "type": "string",
            "default": ""
        },
        "layout": {
            "type": "string",
            "default": "image_name_description"
        },
        "viewMode": {
            "type": "string",
            "default": "grid"
        },
        "linkText": {
            "type": "string",
            "default": ""
        },
        "linkStyle": {
            "type": "string",
            "default": "link"
        },
        "buttonColor": {
            "type": "string",
            "default": "#2271b1"
        },
        "saleBadgeColor": {
            "type": "string",
            "default": "#e63946"
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:../../assets/css/layout-picker.css",
    "style": "file:../../assets/css/prestaspot.css"
}
