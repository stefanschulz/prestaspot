{
    "name": "theloom/prestaspot",
    "description": "Test tooling for the PrestaSpot WordPress plugin. Not part of the shipped plugin package.",
    "type": "project",
    "license": "Apache-2.0",
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "yoast/phpunit-polyfills": "^3.0",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "PrestaSpot\\Tests\\": "tests/Unit/"
        }
    },
    "config": {
        "allow-plugins": true
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist --testsuite Unit",
        "test-integration": "phpunit --configuration phpunit-integration.xml.dist --testsuite Integration",
        "lint": "phpcs"
    }
}
